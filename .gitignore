# =========================================================
#  Octópus — .gitignore  (tek kaynak, tekrarsız, bölümlü)
#  NOT: .gitignore satır-SONU yorum desteklemez; yorumlar ayrı satırda.
# =========================================================

# --- Python / venv / araç önbellekleri ---
.venv/
.venv-*/
__pycache__/
*.pyc
*.pyo
.ruff_cache/
.pytest_cache/

# --- Büyük veri artefaktları ---
# (tools_dist/ + distilled/ altındaki .jsonl ELLE izlenir; kök data/sft/*.jsonl üretilir)
data/corpus/
data/raw/
data/bin/
data/sft/*.jsonl
data/sft/manifest.json
data/sft/tools_aug/

# --- Eğitim / checkpoint / run artefaktları ---
checkpoints/
checkpoints_web/
checkpoints_sft/
checkpoints_fw/
runs/
unsloth_compiled_cache/
runpod_val_log.jsonl
*_val_log.jsonl

# --- Model ağırlıkları (pod'da üretilir, yerelde indirilir) ---
# kök tokenizer çıktısı (*.model / *.vocab) KÜÇÜK + kaynak → versiyonlanır, ignore EDİLMEZ.
# models/ altında Modelfile + README izlenir; büyük tokenizer artefaktı ignore.
*.safetensors
*.bin
*.gguf
*.pt
*.ckpt
*.tgz
models/octopus-v*-tokenizer/

# --- RAG vektör deposu (yeniden inşa edilir) ---
rag/chroma/

# --- HF / model cache ---
.cache/
.hf_cache/
.huggingface/

# --- Agent harness runtime denetim günlüğü ---
lab/logs/

# --- Obsidian (kişisel editör yapılandırması, public repo dışı) ---
.obsidian/

# --- Kişisel oturum notu (public repo dışı) ---
BURADAN-DEVAM.md

# --- Claude Code yerel yapılandırması (public repo dışı) ---
.claude/
CLAUDE.md

# --- OS / editör / geçici ---
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
scratchpad/
