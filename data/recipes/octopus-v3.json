{
  "name": "octopus-v3",
  "description": "Octópus v3 PRODUCTION — Türkçe-önce 62% / siber 32% (secdata güvenlik kodu dahil) / reasoning 6%. weight = HEDEF token-payı. Kod ayrı katman yok (gated/script-based) → güvenlik kodu secdata'da. Primus sonra eklenebilir.",
  "sources": [
    {"name": "lumees-tr",      "dataset": "lumees/turkish-corpus-100b",   "config": "pretrain",      "text_field": "text", "weight": 0.38},
    {"name": "bella-ozenli",   "dataset": "turkish-nlp-suite/BellaTurca",  "config": "OzenliDerlem",   "text_field": "text", "weight": 0.09},
    {"name": "bella-akademik", "dataset": "turkish-nlp-suite/BellaTurca",  "config": "AkademikDerlem", "text_field": "text", "weight": 0.07},
    {"name": "fineweb2-tr",    "dataset": "HuggingFaceFW/fineweb-2",       "config": "tur_Latn",       "text_field": "text", "weight": 0.08},
    {"name": "secdata",        "dataset": "deardaniel/secdata-raw",        "data_files": "sources_manifest.json/raw_docs_chunk_*.jsonl", "text_field": "text", "weight": 0.20},
    {"name": "alican-cve",     "dataset": "AlicanKiraz0/All-CVE-Records-Training-Dataset",             "template": "{User}\n\n{Assistant}", "weight": 0.12},
    {"name": "open-web-math",  "dataset": "open-web-math/open-web-math",                                "text_field": "text", "weight": 0.06}
  ]
}
